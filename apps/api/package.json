{
  "name": "@neurion/api",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/unit-test.ts && tsx scripts/confine-test.ts && tsx scripts/money-test.ts",
    "test:unit": "tsx scripts/unit-test.ts",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "test:money": "tsx scripts/money-test.ts",
    "test:confine": "tsx scripts/confine-test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@prisma/client": "^5.12.0",
    "adm-zip": "^0.5.18",
    "argon2": "^0.40.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "ethers": "^6.13.0",
    "geoip-lite": "^2.0.3",
    "ioredis": "^5.11.1",
    "nodemailer": "^6.9.14",
    "prisma": "^5.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.17.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^6.4.15",
    "@types/ws": "^8.5.10",
    "dotenv-cli": "^7.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5"
  }
}
